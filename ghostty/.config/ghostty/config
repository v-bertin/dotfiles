font-family = "0xProto"
font-size = 20

theme = "gruber-darker"

# remove system level tool bar
window-decoration = "none"

keybind = ctrl+1=increase_font_size:2
keybind = ctrl+minus=decrease_font_size:2

# tabs

keybind = ctrl+e=open_config
keybind = ctrl+u=reload_config

keybind = alt+right=next_tab
keybind = alt+l=next_tab
keybind = alt+left=previous_tab
keybind = alt+h=previous_tab

# splits

keybind = ctrl+shift+h=new_split:down
keybind = ctrl+shift+v=new_split:right

keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down

keybind = ctrl+shift+e=equalize_splits
