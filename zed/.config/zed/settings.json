// vim: set filetype=json5:
//
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "model": "claude-sonnet-4.6",
        "reasoning_effort": "medium",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#plan"
      },
      "type": "registry",
    },
    "Mistral Vibe": {
        "default_config_options": {
          "thinking": "max",
          "mode": "default",
          "model": "mistral-medium-3.5"
        },
        "type": "custom",
        "command": "vibe-acp",
        "args": [],
        "env": {}
    },
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "auto_update": true,
  "buffer_font_family": "0xProto",
  "ui_font_family": "0xProto",
  "auto_install_extensions": {
    "log": true,
    "devicetree": true,
    "Dockerfile": true,
    "Make": true,
    "Mistral Vibe": true,
  },
}
